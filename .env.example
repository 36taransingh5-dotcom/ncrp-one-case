# Production: use Supabase only. Never expose SUPABASE_SECRET_KEY to the browser.
NCRP_BACKEND=supabase
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Local Round 1 fallback only. Production must not set NCRP_BACKEND=local.
NCRP_DATABASE_PATH=./data/ncrp-one-case.db
NCRP_SESSION_SECRET=replace-with-a-long-random-secret
NCRP_UPLOAD_DIR=./uploads

# Protects worker endpoints used to drain the durable job/outbox tables.
NCRP_WORKER_SECRET=replace-with-a-long-random-secret
# Vercel Cron sends this value as the bearer token; it may equal NCRP_WORKER_SECRET.
CRON_SECRET=replace-with-a-long-random-secret

# Optional, synthetic demo identities used only by npm run seed:supabase.
NCRP_DEMO_CITIZEN_EMAIL=citizen-demo@example.test
NCRP_DEMO_CITIZEN_PASSWORD=replace-with-a-strong-demo-password
NCRP_DEMO_OPERATOR_EMAIL=operator-demo@example.test
NCRP_DEMO_OPERATOR_PASSWORD=replace-with-a-different-strong-demo-password
NCRP_SHOWCASE_CITIZEN_EMAIL=showcase-citizen@example.test
NCRP_SHOWCASE_CITIZEN_PASSWORD=replace-with-a-third-strong-demo-password
# Allows one-click server-side sign-in for these synthetic identities only.
NCRP_DEMO_ACCESS_ENABLED=false

# Integrations: simulated, http, or unset. Unset + NCRP_BACKEND=supabase uses
# the in-app HTTP sandbox authenticated with NCRP_WORKER_SECRET.
# HTTP never contacts live government/bank systems.
NCRP_INTEGRATION_MODE=
NCRP_INTEGRATION_TIMEOUT_MS=8000
NCRP_APP_BASE_URL=http://localhost:3000
NCRP_SANDBOX_SECRET=
NCRP_WEBHOOK_SECRET=
NCRP_BANK_API_BASE_URL=
NCRP_BANK_API_KEY=
NCRP_POLICE_API_BASE_URL=
NCRP_POLICE_API_KEY=
NCRP_REPORTING_API_BASE_URL=
NCRP_REPORTING_API_KEY=
NCRP_NOTIFICATION_API_BASE_URL=
NCRP_NOTIFICATION_API_KEY=

# Transactional email. Vercel Resend Marketplace injects RESEND_API_KEY.
# Optional RESEND_FROM overrides Resend's test sender (onboarding@resend.dev).
NCRP_NOTIFICATION_MODE=
RESEND_API_KEY=
RESEND_FROM=

# Optional per-provider overrides: simulated, http, or sandbox.
BANK_INTEGRATION_MODE=
POLICE_INTEGRATION_MODE=
REPORTING_INTEGRATION_MODE=

# DigiLocker requester. Leave disabled until official onboarding exists.
DIGILOCKER_MODE=disabled
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# API Setu. Leave disabled until usable client credentials exist.
API_SETU_MODE=disabled
API_SETU_CLIENT_ID=
API_SETU_CLIENT_SECRET=
