# Production: use Supabase only. Never expose SUPABASE_SECRET_KEY to the browser.
NCRP_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Local Round 1 fallback only. Production must not set NCRP_BACKEND=local.
NCRP_DATABASE_PATH=./data/ncrp-one-case.db
NCRP_SESSION_SECRET=replace-with-a-long-random-secret
NCRP_UPLOAD_DIR=./uploads

# Protects worker endpoints used to drain the durable job/outbox tables.
NCRP_WORKER_SECRET=replace-with-a-long-random-secret
# Vercel Cron sends this value as the bearer token; it may equal NCRP_WORKER_SECRET.
CRON_SECRET=replace-with-a-long-random-secret

# Optional, synthetic demo identities used only by npm run seed:supabase.
NCRP_DEMO_CITIZEN_EMAIL=citizen-demo@example.test
NCRP_DEMO_CITIZEN_PASSWORD=replace-with-a-strong-demo-password
NCRP_DEMO_OPERATOR_EMAIL=operator-demo@example.test
NCRP_DEMO_OPERATOR_PASSWORD=replace-with-a-different-strong-demo-password
NCRP_SHOWCASE_CITIZEN_EMAIL=showcase-citizen@example.test
NCRP_SHOWCASE_CITIZEN_PASSWORD=replace-with-a-third-strong-demo-password
# Allows one-click server-side sign-in for these synthetic identities only.
NCRP_DEMO_ACCESS_ENABLED=false
